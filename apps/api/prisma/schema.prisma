generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets      Ticket[]
  reservations Reservation[]
  events       Event[]
}

enum EventType {
  MOVIE
  SHOW
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  title       String
  description String?
  type        EventType
  externalId  String?
  date        DateTime
  location    String
  capacity    Int?
  price       Decimal     @db.Decimal(10, 2)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  seats        Seat[]
  reservations Reservation[]

  organizer User @relation(fields: [organizerId], references: [id])

  @@index([organizerId])
  @@index([status])
  @@index([date])
}

enum TicketStatus {
  ACTIVE
  CANCELLED
  USED
}

model Ticket {
  id            String       @id @default(uuid())
  reservationId String
  seatId        String
  status        TicketStatus @default(ACTIVE)
  code          String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
  seat        Seat        @relation(fields: [seatId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
  userId      String?

  @@unique([reservationId, seatId])
  @@index([status])
  @@index([seatId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
}

model Reservation {
  id          String            @id @default(uuid())
  userId      String
  eventId     String
  quantity    Int
  totalAmount Decimal           @db.Decimal(10, 2)
  status      ReservationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

enum SeatType {
  STANDARD
  PREMIUM
  ACCESSIBLE
}

model Seat {
  id        String   @id @default(uuid())
  eventId   String
  row       String
  number    Int
  type      SeatType @default(STANDARD)
  createdAt DateTime @default(now())

  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]

  @@unique([eventId, row, number])
  @@index([eventId])
}
