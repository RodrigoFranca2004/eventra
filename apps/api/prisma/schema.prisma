generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events Event[]
}

enum EventType {
  MOVIE
  SHOW
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  title       String
  description String?
  type        EventType
  externalId  String?
  date        DateTime
  location    String
  capacity    Int
  price       Decimal     @db.Decimal(10, 2)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  organizer User @relation(fields: [organizerId], references: [id])

  @@index([organizerId])
  @@index([status])
  @@index([date])
}