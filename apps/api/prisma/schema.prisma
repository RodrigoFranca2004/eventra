generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events Event[]
  tickets Ticket[]
}

enum EventType {
  MOVIE
  SHOW
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  title       String
  description String?
  type        EventType
  externalId  String?
  date        DateTime
  location    String
  capacity    Int
  price       Decimal     @db.Decimal(10, 2)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tickets Ticket[]

  organizer User @relation(fields: [organizerId], references: [id])

  @@index([organizerId])
  @@index([status])
  @@index([date])
}

enum TicketStatus {
  ACTIVE
  CANCELLED
  USED
}

model Ticket {
  id        String       @id @default(uuid())
  userId    String
  eventId   String
  status    TicketStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([status])
}